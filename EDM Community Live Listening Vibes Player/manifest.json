{
  "manifest_version": 3,
  "name": "EDMC Music Player",
  "version": "1.0.5",
  "description": "Play music from edmc.to forum posts with categorized playlists.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://edmc.to/*",
    "https://beatexs.com/*",
    "https://*.flenxi.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://edmc.to/*", "https://beatexs.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["player.html", "popup.js", "wavesurfer.min.js"],
      "matches": ["https://edmc.to/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; media-src https://edmc.to https://beatexs.com https://*.flenxi.com"
  }
}